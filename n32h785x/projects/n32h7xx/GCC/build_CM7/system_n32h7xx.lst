1742:../../../firmware/CMSIS/core/core_cm7.h ****   \brief   Mask and shift a bit field value for use in a register bit range.
ARM GAS  /tmp/ccnD5HTU.s 			page 32


1743:../../../firmware/CMSIS/core/core_cm7.h ****   \param[in] field  Name of the register bit field.
1744:../../../firmware/CMSIS/core/core_cm7.h ****   \param[in] value  Value of the bit field. This parameter is interpreted as an uint32_t type.
1745:../../../firmware/CMSIS/core/core_cm7.h ****   \return           Masked and shifted value.
1746:../../../firmware/CMSIS/core/core_cm7.h **** */
1747:../../../firmware/CMSIS/core/core_cm7.h **** #define _VAL2FLD(field, value)    (((uint32_t)(value) << field ## _Pos) & field ## _Msk)
1748:../../../firmware/CMSIS/core/core_cm7.h **** 
1749:../../../firmware/CMSIS/core/core_cm7.h **** /**
1750:../../../firmware/CMSIS/core/core_cm7.h ****   \brief     Mask and shift a register value to extract a bit filed value.
1751:../../../firmware/CMSIS/core/core_cm7.h ****   \param[in] field  Name of the register bit field.
1752:../../../firmware/CMSIS/core/core_cm7.h ****   \param[in] value  Value of register. This parameter is interpreted as an uint32_t type.
1753:../../../firmware/CMSIS/core/core_cm7.h ****   \return           Masked and shifted bit field value.
1754:../../../firmware/CMSIS/core/core_cm7.h **** */
1755:../../../firmware/CMSIS/core/core_cm7.h **** #define _FLD2VAL(field, value)    (((uint32_t)(value) & field ## _Msk) >> field ## _Pos)
1756:../../../firmware/CMSIS/core/core_cm7.h **** 
1757:../../../firmware/CMSIS/core/core_cm7.h **** /*@} end of group CMSIS_core_bitfield */
