 265:../../../firmware/n32h7xx_std_periph_driver/src/n32h7xx_lpuart.c **** *\*\          - LPUART_INT_TXFIFO_OV TX FIFO Overflow Interrupt
 266:../../../firmware/n32h7xx_std_periph_driver/src/n32h7xx_lpuart.c **** *\*\          - LPUART_INT_WUF       Wake-Up Interrupt
 267:../../../firmware/n32h7xx_std_periph_driver/src/n32h7xx_lpuart.c **** *\*\          - LPUART_INT_RXFIFO_NE RX FIFO Non-Empty Interrupt
 268:../../../firmware/n32h7xx_std_periph_driver/src/n32h7xx_lpuart.c **** *\*\          - LPUART_INT_RXFIFO_HF RX FIFO Half Full Interrupt
 269:../../../firmware/n32h7xx_std_periph_driver/src/n32h7xx_lpuart.c **** *\*\          - LPUART_INT_RXFIFO_FU RX FIFO Full Interrupt Enable
 270:../../../firmware/n32h7xx_std_periph_driver/src/n32h7xx_lpuart.c **** *\*\          - LPUART_INT_RXFIFO_OV RX FIFO Overflow Interrupt
