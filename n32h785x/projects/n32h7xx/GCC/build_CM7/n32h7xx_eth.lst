 122:../../../firmware/n32h7xx_std_periph_driver/src/n32h7xx_eth.c **** /* ETH Tick&Delay through the DWT module */
 123:../../../firmware/n32h7xx_std_periph_driver/src/n32h7xx_eth.c **** #define __ETH_TICK_START()                      CPU_DELAY_INTI()
 124:../../../firmware/n32h7xx_std_periph_driver/src/n32h7xx_eth.c **** #define __ETH_GET_TICK                          DWT_CYCCNT
 125:../../../firmware/n32h7xx_std_periph_driver/src/n32h7xx_eth.c **** #define __ETH_TICK_STOP()                       CPU_DELAY_DISABLE()
 126:../../../firmware/n32h7xx_std_periph_driver/src/n32h7xx_eth.c **** #define __ETH_DELAY(Cnt)                        do{                                                
 127:../../../firmware/n32h7xx_std_periph_driver/src/n32h7xx_eth.c ****                                                     /* Check that DWT is enabled or not */         
 128:../../../firmware/n32h7xx_std_periph_driver/src/n32h7xx_eth.c ****                                                     if ((DEM_CR & DEM_CR_TRCENA) == (uint32_t)RESET
 129:../../../firmware/n32h7xx_std_periph_driver/src/n32h7xx_eth.c ****                                                     {                                              
 130:../../../firmware/n32h7xx_std_periph_driver/src/n32h7xx_eth.c ****                                                         /* Enable and initialize DWT */            
 131:../../../firmware/n32h7xx_std_periph_driver/src/n32h7xx_eth.c ****                                                         __ETH_TICK_START();                        
 132:../../../firmware/n32h7xx_std_periph_driver/src/n32h7xx_eth.c ****                                                     }                                              
 133:../../../firmware/n32h7xx_std_periph_driver/src/n32h7xx_eth.c ****                                                     Cnt += __ETH_GET_TICK;                         
 134:../../../firmware/n32h7xx_std_periph_driver/src/n32h7xx_eth.c ****                                                     while (__ETH_GET_TICK < Cnt){};                
 135:../../../firmware/n32h7xx_std_periph_driver/src/n32h7xx_eth.c ****                                                     __ETH_TICK_STOP();                             
 136:../../../firmware/n32h7xx_std_periph_driver/src/n32h7xx_eth.c ****                                                 } while (0)
 137:../../../firmware/n32h7xx_std_periph_driver/src/n32h7xx_eth.c **** 
