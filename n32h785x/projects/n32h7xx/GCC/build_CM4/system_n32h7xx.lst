1639:../../../firmware/CMSIS/core/core_cm4.h **** /**
1640:../../../firmware/CMSIS/core/core_cm4.h ****   \brief   Set Priority Grouping
1641:../../../firmware/CMSIS/core/core_cm4.h ****   \details Sets the priority grouping field using the required unlock sequence.
1642:../../../firmware/CMSIS/core/core_cm4.h ****            The parameter PriorityGroup is assigned to the field SCB->AIRCR [10:8] PRIGROUP field.
1643:../../../firmware/CMSIS/core/core_cm4.h ****            Only values from 0..7 are used.
1644:../../../firmware/CMSIS/core/core_cm4.h ****            In case of a conflict between priority grouping and available
1645:../../../firmware/CMSIS/core/core_cm4.h ****            priority bits (__NVIC_PRIO_BITS), the smallest possible priority group is set.
1646:../../../firmware/CMSIS/core/core_cm4.h ****   \param [in]      PriorityGroup  Priority grouping field.
1647:../../../firmware/CMSIS/core/core_cm4.h ****  */
1648:../../../firmware/CMSIS/core/core_cm4.h **** __STATIC_INLINE void __NVIC_SetPriorityGrouping(uint32_t PriorityGroup)
1649:../../../firmware/CMSIS/core/core_cm4.h **** {
1650:../../../firmware/CMSIS/core/core_cm4.h ****   uint32_t reg_value;
1651:../../../firmware/CMSIS/core/core_cm4.h ****   uint32_t PriorityGroupTmp = (PriorityGroup & (uint32_t)0x07UL);             /* only values 0..7 a
1652:../../../firmware/CMSIS/core/core_cm4.h **** 
1653:../../../firmware/CMSIS/core/core_cm4.h ****   reg_value  =  SCB->AIRCR;                                                   /* read old register 
1654:../../../firmware/CMSIS/core/core_cm4.h ****   reg_value &= ~((uint32_t)(SCB_AIRCR_VECTKEY_Msk | SCB_AIRCR_PRIGROUP_Msk)); /* clear bits to chan
1655:../../../firmware/CMSIS/core/core_cm4.h ****   reg_value  =  (reg_value                                   |
1656:../../../firmware/CMSIS/core/core_cm4.h ****                 ((uint32_t)0x5FAUL << SCB_AIRCR_VECTKEY_Pos) |
1657:../../../firmware/CMSIS/core/core_cm4.h ****                 (PriorityGroupTmp << SCB_AIRCR_PRIGROUP_Pos)  );              /* Insert write key a
1658:../../../firmware/CMSIS/core/core_cm4.h ****   SCB->AIRCR =  reg_value;
1659:../../../firmware/CMSIS/core/core_cm4.h **** }
1660:../../../firmware/CMSIS/core/core_cm4.h **** 
1661:../../../firmware/CMSIS/core/core_cm4.h **** 
1662:../../../firmware/CMSIS/core/core_cm4.h **** /**
1663:../../../firmware/CMSIS/core/core_cm4.h ****   \brief   Get Priority Grouping
1664:../../../firmware/CMSIS/core/core_cm4.h ****   \details Reads the priority grouping field from the NVIC Interrupt Controller.
1665:../../../firmware/CMSIS/core/core_cm4.h ****   \return                Priority grouping field (SCB->AIRCR [10:8] PRIGROUP field).
1666:../../../firmware/CMSIS/core/core_cm4.h ****  */
1667:../../../firmware/CMSIS/core/core_cm4.h **** __STATIC_INLINE uint32_t __NVIC_GetPriorityGrouping(void)
1668:../../../firmware/CMSIS/core/core_cm4.h **** {
1669:../../../firmware/CMSIS/core/core_cm4.h ****   return ((uint32_t)((SCB->AIRCR & SCB_AIRCR_PRIGROUP_Msk) >> SCB_AIRCR_PRIGROUP_Pos));
