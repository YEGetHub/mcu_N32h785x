1518:../../../firmware/CMSIS/core/core_cm4.h **** /**
1519:../../../firmware/CMSIS/core/core_cm4.h ****   \brief   Mask and shift a bit field value for use in a register bit range.
1520:../../../firmware/CMSIS/core/core_cm4.h ****   \param[in] field  Name of the register bit field.
1521:../../../firmware/CMSIS/core/core_cm4.h ****   \param[in] value  Value of the bit field. This parameter is interpreted as an uint32_t type.
1522:../../../firmware/CMSIS/core/core_cm4.h ****   \return           Masked and shifted value.
1523:../../../firmware/CMSIS/core/core_cm4.h **** */
1524:../../../firmware/CMSIS/core/core_cm4.h **** #define _VAL2FLD(field, value)    (((uint32_t)(value) << field ## _Pos) & field ## _Msk)
1525:../../../firmware/CMSIS/core/core_cm4.h **** 
1526:../../../firmware/CMSIS/core/core_cm4.h **** /**
1527:../../../firmware/CMSIS/core/core_cm4.h ****   \brief     Mask and shift a register value to extract a bit filed value.
