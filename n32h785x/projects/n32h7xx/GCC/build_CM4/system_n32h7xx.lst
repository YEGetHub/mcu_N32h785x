1530:../../../firmware/CMSIS/core/core_cm4.h ****   \return           Masked and shifted bit field value.
1531:../../../firmware/CMSIS/core/core_cm4.h **** */
1532:../../../firmware/CMSIS/core/core_cm4.h **** #define _FLD2VAL(field, value)    (((uint32_t)(value) & field ## _Msk) >> field ## _Pos)
