 105:../../../firmware/n32h7xx_std_periph_driver/src/n32h7xx_eth.c **** /* ETH tx descriptor index increment */
 106:../../../firmware/n32h7xx_std_periph_driver/src/n32h7xx_eth.c **** #define __ETH_TXDESC_INDEX_INCR(Index, Offset)  do {                                               
 107:../../../firmware/n32h7xx_std_periph_driver/src/n32h7xx_eth.c ****                                                     (Index) += (Offset);                           
 108:../../../firmware/n32h7xx_std_periph_driver/src/n32h7xx_eth.c ****                                                         if ((Index) >= ETH_TX_DESC_NUMBER)         
 109:../../../firmware/n32h7xx_std_periph_driver/src/n32h7xx_eth.c ****                                                         {                                          
 110:../../../firmware/n32h7xx_std_periph_driver/src/n32h7xx_eth.c ****                                                             (Index) = ((Index) - ETH_TX_DESC_NUMBER
 111:../../../firmware/n32h7xx_std_periph_driver/src/n32h7xx_eth.c ****                                                         }                                          
 112:../../../firmware/n32h7xx_std_periph_driver/src/n32h7xx_eth.c ****                                                 } while (0)
 113:../../../firmware/n32h7xx_std_periph_driver/src/n32h7xx_eth.c **** /* ETH rx descriptor index increment */
 114:../../../firmware/n32h7xx_std_periph_driver/src/n32h7xx_eth.c **** #define __ETH_RXDESC_INDEX_INCR(Index, Offset)  do {                                               
 115:../../../firmware/n32h7xx_std_periph_driver/src/n32h7xx_eth.c ****                                                     (Index) += (Offset);                           
 116:../../../firmware/n32h7xx_std_periph_driver/src/n32h7xx_eth.c ****                                                         if ((Index) >= ETH_RX_DESC_NUMBER)         
 117:../../../firmware/n32h7xx_std_periph_driver/src/n32h7xx_eth.c ****                                                         {                                          
 118:../../../firmware/n32h7xx_std_periph_driver/src/n32h7xx_eth.c ****                                                             (Index) = ((Index) - ETH_RX_DESC_NUMBER
 119:../../../firmware/n32h7xx_std_periph_driver/src/n32h7xx_eth.c ****                                                         }                                          
 120:../../../firmware/n32h7xx_std_periph_driver/src/n32h7xx_eth.c ****                                                 } while (0)
