  57:../../../firmware/n32h7xx_std_periph_driver/src/n32h7xx_shrtim.c **** /**
  58:../../../firmware/n32h7xx_std_periph_driver/src/n32h7xx_shrtim.c **** *\*\fun  Select the SHRTIM synchronization input source.
  59:../../../firmware/n32h7xx_std_periph_driver/src/n32h7xx_shrtim.c **** *\*\note This function must not be called when  the concerned timer(s) is (are) enabled .
  60:../../../firmware/n32h7xx_std_periph_driver/src/n32h7xx_shrtim.c **** *\*\param  SHRTIMx Super High Resolution Timer instance
  61:../../../firmware/n32h7xx_std_periph_driver/src/n32h7xx_shrtim.c **** *\*\param  SyncInSrc This parameter can be one of the following values:
  62:../../../firmware/n32h7xx_std_periph_driver/src/n32h7xx_shrtim.c **** *\*\        - SHRTIM_SYNCIN_SRC_INTERNAL_EVENT_0    from ATIM1 trgo
  63:../../../firmware/n32h7xx_std_periph_driver/src/n32h7xx_shrtim.c **** *\*\        - SHRTIM_SYNCIN_SRC_INTERNAL_EVENT_1    from ATIM2 trgo
  64:../../../firmware/n32h7xx_std_periph_driver/src/n32h7xx_shrtim.c **** *\*\        - SHRTIM_SYNCIN_SRC_INTERNAL_EVENT_2    from ATIM3 trgo
  65:../../../firmware/n32h7xx_std_periph_driver/src/n32h7xx_shrtim.c **** *\*\        - SHRTIM_SYNCIN_SRC_EXTERNAL_EVENT_3    from IOM
  66:../../../firmware/n32h7xx_std_periph_driver/src/n32h7xx_shrtim.c **** *\*\        - SHRRIM_SYNCIN_SRC_INTERNAL_EVENT_4    from shrtim_out_sync2 of another SHRTIM
  67:../../../firmware/n32h7xx_std_periph_driver/src/n32h7xx_shrtim.c **** *\*\return None
  68:../../../firmware/n32h7xx_std_periph_driver/src/n32h7xx_shrtim.c **** **/
