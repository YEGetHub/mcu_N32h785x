 587:../../../firmware/n32h7xx_std_periph_driver/src/n32h7xx_lptim.c **** /**
 588:../../../firmware/n32h7xx_std_periph_driver/src/n32h7xx_lptim.c **** *\*\name    LPTIM_TimeoutCmd.
 589:../../../firmware/n32h7xx_std_periph_driver/src/n32h7xx_lptim.c **** *\*\fun     Enables or disables the LPTIM timeout function.
 590:../../../firmware/n32h7xx_std_periph_driver/src/n32h7xx_lptim.c **** *\*\param   LPTIMx (The input parameters must be the following values):
 591:../../../firmware/n32h7xx_std_periph_driver/src/n32h7xx_lptim.c **** *\*\          - LPTIM1
 592:../../../firmware/n32h7xx_std_periph_driver/src/n32h7xx_lptim.c **** *\*\          - LPTIM2
 593:../../../firmware/n32h7xx_std_periph_driver/src/n32h7xx_lptim.c **** *\*\          - LPTIM3
 594:../../../firmware/n32h7xx_std_periph_driver/src/n32h7xx_lptim.c **** *\*\          - LPTIM4
 595:../../../firmware/n32h7xx_std_periph_driver/src/n32h7xx_lptim.c **** *\*\          - LPTIM5
 596:../../../firmware/n32h7xx_std_periph_driver/src/n32h7xx_lptim.c **** *\*\param   Cmd (The input parameters must be the following values):
 597:../../../firmware/n32h7xx_std_periph_driver/src/n32h7xx_lptim.c **** *\*\          - ENABLE
 598:../../../firmware/n32h7xx_std_periph_driver/src/n32h7xx_lptim.c **** *\*\          - DISABLE
 599:../../../firmware/n32h7xx_std_periph_driver/src/n32h7xx_lptim.c **** *\*\return  none
 600:../../../firmware/n32h7xx_std_periph_driver/src/n32h7xx_lptim.c **** *\*\note    This function must be called when the LPTIM instance is disabled.
 601:../../../firmware/n32h7xx_std_periph_driver/src/n32h7xx_lptim.c **** *\*\note    The first trigger event will start the timer, any successive trigger
 602:../../../firmware/n32h7xx_std_periph_driver/src/n32h7xx_lptim.c **** *\*\        event will reset the counter and the timer will restart.
 603:../../../firmware/n32h7xx_std_periph_driver/src/n32h7xx_lptim.c **** *\*\note    The timeout value corresponds to the compare value; if no trigger
 604:../../../firmware/n32h7xx_std_periph_driver/src/n32h7xx_lptim.c **** *\*\        occurs within the expected time frame, the MCU is waked-up by the
 605:../../../firmware/n32h7xx_std_periph_driver/src/n32h7xx_lptim.c **** *\*\        compare match event.
 606:../../../firmware/n32h7xx_std_periph_driver/src/n32h7xx_lptim.c **** *\*\note    A trigger event arriving when the timer is already started will be
 607:../../../firmware/n32h7xx_std_periph_driver/src/n32h7xx_lptim.c **** *\*\        ignored.
 608:../../../firmware/n32h7xx_std_periph_driver/src/n32h7xx_lptim.c **** **/
 609:../../../firmware/n32h7xx_std_periph_driver/src/n32h7xx_lptim.c **** void LPTIM_TimeoutCmd(LPTIM_Module* LPTIMx, FunctionalStatus Cmd)
